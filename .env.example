# Bind to loopback for local development. Use Tailscale/private IP later.
ROAD_SCOUT_HOST=127.0.0.1
ROAD_SCOUT_PORT=18787
# Set before exposing beyond the Mac. Do not commit the real value.
ROAD_SCOUT_MCP_TOKEN=replace-with-a-long-random-token
# Jev is optional until the source adapter smoke tests pass.
TYPESAFE_API_KEY=
# Optional Amap (高德) web-service key for geocoding Chinese POIs.
# Without it, distance support falls back to Nominatim (limited China POI coverage).
AMAP_API_KEY=
OPENCLI_BIN=opencli
AGENT_REACH_BIN=agent-reach
