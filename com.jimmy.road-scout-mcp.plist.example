<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jimmy.road-scout-mcp</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/jimmymacmini/workspace/sandbox/road-scout-mcp/scripts/run.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/jimmymacmini/workspace/sandbox/road-scout-mcp</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/jimmymacmini/workspace/sandbox/road-scout-mcp/road-scout-mcp.log</string>
